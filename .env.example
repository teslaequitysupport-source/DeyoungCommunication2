# ═══════════════════════════════════════════════════════════════════════════
# AI Live Character Platform — environment template (copy to .env)
#
# Variable classes follow the approved Phase-1 report (Ch. 15):
#   PUBLIC / SERVER / DATABASE / STORAGE / MEDIA / WORKER / AI / ANALYTICS /
#   PAYMENT (deferred). Never commit real values. This file is the contract.
# ═══════════════════════════════════════════════════════════════════════════

# ── PUBLIC ──────────────────────────────────────────────────────────────────
# Client-safe by design.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SERVER: authentication ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins allowed to call auth endpoints (wildcards supported).
# Production: your real domain(s) only. No wildcards unless you own the domain.
TRUSTED_ORIGINS=http://localhost:3000

# ── DATABASE ────────────────────────────────────────────────────────────────
# Development (this sandbox): the pglite-db mini service exposes ONE embedded
# Postgres over the wire protocol on 127.0.0.1:6543. The app connects with
# node-postgres — the identical code path used for deployment.
DATABASE_URL=postgresql://127.0.0.1:6543/postgres
# Deployment: Neon Postgres — same URL shape, different host:
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
# Data directory used by the pglite-db service (rarely needed):
# PGLITE_PATH=

# ── STORAGE: Cloudflare R2 (Phase 1) ────────────────────────────────────────
# When set, uploads use presigned R2 PUTs (direct browser → R2). When unset,
# the platform runs on the local-dev object store (ticketed server uploads) —
# an honest development backend, never presented as R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# HMAC secret for local-dev upload/download tickets (required in local-dev
# storage mode). Generate with: openssl rand -hex 32
STORAGE_TICKET_SECRET=

# ── MEDIA: LiveKit (production) / media-relay (dev transport) ───────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# HMAC secret for media-relay tickets (dev transport). Same value must be set
# for the media-relay mini service. Generate with: openssl rand -hex 32
REALTIME_TICKET_SECRET=

# ── WORKER: GPU workers (Phase 1+) ───────────────────────────────────────────
WORKER_ID=
CONTROL_PLANE_URL=
WORKER_CREDENTIAL=
WORKER_NAME=
WORKER_PROVIDER=DEVELOPMENT_LOCAL
MEDIA_RELAY_URL=http://127.0.0.1:3031

# ── CONTROL PLANE: scheduler daemon token (mini-services/control-scheduler) ─
# Same value must be set for the control-scheduler mini service.
SCHEDULER_TOKEN=

# ── COMPUTE SLEEP SYSTEM (spec §45) ────────────────────────────────────────
# How long a worker may sit IDLE with zero active jobs before the scheduler
# sleeps it (milliseconds). Default 120000 (2 min). A job that needs a
# sleeping worker triggers an honest cold start: wake_requested_at is set,
# the worker's next poll completes the wake handshake, then it claims.
# Shorten for dev demos (e.g. 30000); tune per provider cost in production.
WORKER_IDLE_SLEEP_MS=120000

# ── AI: model capabilities (Phase 2) ────────────────────────────────────────
# MiniMax H3 is consumed through the official API only (approved decision #3;
# self-host commercial use requires written MiniMax permission).
#
# WORKER-SIDE (spec §9 external-credential gate): set these on the worker's
# environment, not the web control plane. Both H3_API_BASE_URL and H3_API_KEY
# must be present for the worker to announce the `video.h3` capability —
# otherwise video.generate.h3 jobs wait honestly for a capable worker.
# Re-verify endpoint paths against current platform.minimax.io docs when
# credentials are provisioned (spec §9 verify-list).
H3_API_BASE_URL=
H3_API_KEY=
H3_MODEL=MiniMax-H3
H3_GROUP_ID=
#
# Brain LLM provider (later phase — the orchestration layer's own model,
# separate from H3 video generation): provider name + key, env-only.
BRAIN_LLM_PROVIDER=
BRAIN_LLM_API_KEY=

# ── ANALYTICS: PostHog, consent-gated (Phase 3) ─────────────────────────────
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_OPT_IN=false

# ── CREDITS (spec §41 — manual credits until payments are integrated) ───────
# Welcome balance granted at sign-up. 0 disables the bonus entirely.
SIGNUP_BONUS_CREDITS=100
# Per-job-type cost overrides (credits). Defaults when unset:
#   transform.image.colorgrade = 1, transform.live.colorgrade = 0 (free),
#   video.generate.h3 = 50. Unknown types cannot be enqueued at all.
# Example: CREDITS_COST_VIDEO_GENERATE_H3=25
# CREDITS_COST_TRANSFORM_IMAGE_COLORGRADE=
# CREDITS_COST_TRANSFORM_LIVE_COLORGRADE=
# CREDITS_COST_VIDEO_GENERATE_H3=

# ── RETENTION (spec §35 — days; 0 = keep forever) ──────────────────────────
# Scheduled sweep deletes: media older than RETENTION_ASSETS_DAYS, ended
# sessions older than RETENTION_LIVE_SESSIONS_DAYS, terminal jobs older
# than RETENTION_JOBS_DAYS, closed reports older than RETENTION_REPORTS_DAYS,
# audit rows older than RETENTION_AUDIT_DAYS. Consent evidence outlives the
# media it covered (de-linked). The sweep runs ~daily from the scheduler
# and every run is audited.
RETENTION_ASSETS_DAYS=365
RETENTION_LIVE_SESSIONS_DAYS=90
RETENTION_JOBS_DAYS=180
RETENTION_REPORTS_DAYS=730
RETENTION_AUDIT_DAYS=730

# ── LEGAL: operator identity (spec §40 — never invented) ───────────────────
# Rendered on every legal page. When unset, pages show an explicit
# "not yet configured" marker instead of a fabricated company.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=

# ── PAYMENT: deferred (approved decision #5 — manual credits until
#    a provider is selected and verified for Nigeria) ──────────────────────────
# PAYMENT_PROVIDER=
