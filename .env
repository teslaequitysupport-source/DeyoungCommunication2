# ── Phase 0 sandbox development environment ────────────────────────────────
# Postgres via the pglite-db mini service (wire protocol on 127.0.0.1:6543).
# Same node-postgres code path as the Neon deployment — only the URL differs.
DATABASE_URL=postgresql://127.0.0.1:6543/postgres

# Better Auth (see .env.example for what each value controls)
AUTH_SECRET=82c6d6cffdc6c35539733fc0a060472c68936bc345680001647917853cc6dbd3
BETTER_AUTH_URL=http://localhost:3000
# Sandbox preview proxy origin (wildcard) — replace with your real origins in production
TRUSTED_ORIGINS=https://*.space-z.ai
